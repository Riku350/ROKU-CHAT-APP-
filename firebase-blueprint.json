{
  "entities": {
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Bootstrap connectivity verification document",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "checkedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["ok", "checkedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator marker document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly discoverable RIKZEN CHAT identity without private PII",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rikzenId": { "type": "string", "minLength": 8, "maxLength": 24, "pattern": "^RIKZEN-[A-Z0-9]{4,12}$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 220 },
        "onboardingCompleted": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "lastSeenPrivacy": { "type": "string", "enum": ["everyone", "friends", "nobody"] },
        "onlineStatusPrivacy": { "type": "string", "enum": ["everyone", "friends", "nobody"] },
        "discoverableByName": { "type": "boolean" },
        "typingInConversationId": { "type": "string", "maxLength": 128 },
        "typingActivity": { "type": "string", "enum": ["typing", "recording", "idle"] },
        "typingUpdatedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "rikzenId", "fullName", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private PII and personal preferences accessible strictly by owner or admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rikzenId": { "type": "string", "minLength": 8, "maxLength": 24, "pattern": "^RIKZEN-[A-Z0-9]{4,12}$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "dateOfBirth": { "type": "string", "maxLength": 24 },
        "theme": { "type": "string", "enum": ["dark", "light", "system"] },
        "wallpaper": { "type": "string", "enum": ["obsidian-web", "midnight", "emerald-silk", "champagne-mist"] },
        "accentColor": { "type": "string", "enum": ["gold", "emerald", "ivory"] },
        "fontSize": { "type": "string", "enum": ["small", "medium", "large"] },
        "bubbleStyle": { "type": "string", "enum": ["rounded", "classic", "minimal"] },
        "appLanguage": { "type": "string", "maxLength": 16 },
        "lastSeen": { "type": "string", "enum": ["everyone", "friends", "nobody"] },
        "onlineStatus": { "type": "string", "enum": ["everyone", "friends", "nobody"] },
        "profilePhoto": { "type": "string", "enum": ["everyone", "friends", "nobody"] },
        "bioVisibility": { "type": "string", "enum": ["everyone", "friends", "nobody"] },
        "emailVisibility": { "type": "string", "enum": ["everyone", "friends", "nobody"] },
        "friendRequests": { "type": "string", "enum": ["everyone", "nobody"] },
        "readReceipts": { "type": "boolean" },
        "discoverableByName": { "type": "boolean" },
        "discoverableByPhone": { "type": "boolean" },
        "blockedUids": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "rikzenId", "email", "createdAt", "updatedAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Cross-user friend connection request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiverUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "senderUid", "receiverUid", "status", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct or group chat room header",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "inviteCode": { "type": "string", "maxLength": 32 },
        "onlyAdminsMessage": { "type": "boolean" },
        "onlyAdminsEditInfo": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "peerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array", "items": { "type": "string" } },
        "lastMessageId": { "type": "string", "maxLength": 128 },
        "lastMessageText": { "type": "string", "maxLength": 500 },
        "lastMessageType": { "type": "string", "maxLength": 32 },
        "lastMessageSenderUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "type", "title", "createdBy", "createdAt", "updatedAt"]
    },
    "ConversationMember": {
      "title": "ConversationMember",
      "description": "Membership record and personal chat controls inside a conversation subcollection",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["owner", "admin", "member"] },
        "muted": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "markedUnread": { "type": "boolean" },
        "disappearingSeconds": { "type": "integer" },
        "chatTheme": { "type": "string", "maxLength": 32 },
        "customList": { "type": "string", "maxLength": 64 },
        "clearedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "lastReadAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "joinedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "conversationId", "role", "joinedAt"]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "Real-time message stored inside a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "messageType": {
          "type": "string",
          "enum": ["text", "image", "video", "document", "audio", "voice", "location", "system"]
        },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToText": { "type": "string", "maxLength": 500 },
        "replyToSender": { "type": "string", "maxLength": 80 },
        "replyToType": { "type": "string", "maxLength": 32 },
        "forwardedFromId": { "type": "string", "maxLength": 128 },
        "fileUrl": { "type": "string", "maxLength": 2048 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "fileName": { "type": "string", "maxLength": 200 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "sizeBytes": { "type": "integer" },
        "durationSeconds": { "type": "integer" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "isEdited": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "starredBy": { "type": "array", "items": { "type": "string" } },
        "deletedForUids": { "type": "array", "items": { "type": "string" } },
        "reactions": { "type": "array", "items": { "type": "object" } },
        "deliveredAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "readAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "conversationId", "senderUid", "content", "messageType", "isDeleted", "createdAt", "updatedAt"]
    },
    "StatusUpdate": {
      "title": "StatusUpdate",
      "description": "24-hour expiring status update",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mediaType": { "type": "string", "enum": ["text", "image", "video"] },
        "content": { "type": "string", "maxLength": 1000 },
        "mediaUrl": { "type": "string", "maxLength": 2048 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "caption": { "type": "string", "maxLength": 300 },
        "backgroundColor": { "type": "string", "maxLength": 32 },
        "fontStyle": { "type": "string", "enum": ["sans", "serif", "bold", "mono"] },
        "durationSeconds": { "type": "integer" },
        "privacy": { "type": "string", "enum": ["everyone", "friends", "contacts", "selected"] },
        "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "authorUid", "mediaType", "expiresAt", "createdAt"]
    },
    "StatusView": {
      "title": "StatusView",
      "description": "Status view and reaction record",
      "type": "object",
      "properties": {
        "viewerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "viewerName": { "type": "string", "maxLength": 80 },
        "viewerAvatar": { "type": "string", "maxLength": 2048 },
        "viewerRikzenId": { "type": "string", "maxLength": 24 },
        "reaction": { "type": "string", "maxLength": 16 },
        "viewedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["viewerUid", "viewedAt"]
    },
    "CallRecord": {
      "title": "CallRecord",
      "description": "1-to-1 WebRTC voice or video call record and SDP signaling state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "callerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "calleeUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "callType": { "type": "string", "enum": ["voice", "video"] },
        "status": { "type": "string", "enum": ["ringing", "connected", "ended", "missed", "rejected", "busy"] },
        "offerSdp": { "type": "string", "maxLength": 30000 },
        "answerSdp": { "type": "string", "maxLength": 30000 },
        "durationSeconds": { "type": "integer" },
        "startedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "endedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "callerUid", "calleeUid", "callType", "status", "startedAt", "updatedAt"]
    },
    "CallCandidate": {
      "title": "CallCandidate",
      "description": "WebRTC ICE candidate for a call session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "candidate": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "senderUid", "candidate", "createdAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "User-scoped notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 500 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "recipientUid", "title", "body", "isRead", "createdAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Safety and moderation report submitted by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["user", "message", "group", "channel", "feedback"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "reporterUid", "targetType", "targetId", "reason", "status", "createdAt"]
    }
  },
  "firestore": {
    "/test/connection": {
      "schema": { "$ref": "#/entities/ConnectionTest" },
      "description": "Health and connectivity check document"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator directory"
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Non-PII public discovery profile keyed by Firebase UID"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private PII and account preferences strictly isolated to owner and admins"
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend connection requests between verified users"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Conversation metadata records"
    },
    "/conversations/{conversationId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/ConversationMember" },
      "description": "Conversation membership subcollection (Master Gate)"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConversationMessage" },
      "description": "Conversation messages gated by parent membership subcollection"
    },
    "/statuses/{statusId}": {
      "schema": { "$ref": "#/entities/StatusUpdate" },
      "description": "24-hour status updates"
    },
    "/statuses/{statusId}/views/{viewerUid}": {
      "schema": { "$ref": "#/entities/StatusView" },
      "description": "Status viewers and reactions"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallRecord" },
      "description": "Voice and video call records and WebRTC signaling"
    },
    "/calls/{callId}/candidates/{candId}": {
      "schema": { "$ref": "#/entities/CallCandidate" },
      "description": "WebRTC ICE candidates for real peer-to-peer calling"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User-owned notifications"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "User safety reports and feedback"
    }
  }
}
