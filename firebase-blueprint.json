{
  "entities": {
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Bootstrap connectivity verification document",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "Indicates Firestore connectivity check passed"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Timestamp of check"
        }
      },
      "required": ["ok", "checkedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator marker document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Administrator verified email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Server timestamp when admin access was granted"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly discoverable RIKZEN CHAT identity without private PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID"
        },
        "rikzenId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 24,
          "pattern": "^RIKZEN-[A-Z0-9]{4,12}$",
          "description": "Permanent unique RIKZEN User ID"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display full name"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 512,
          "description": "Profile picture URL"
        },
        "bio": {
          "type": "string",
          "maxLength": 220,
          "description": "Public profile bio"
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether onboarding is complete"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Current presence flag"
        },
        "discoverableByName": {
          "type": "boolean",
          "description": "Controls name search visibility"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Last update server timestamp"
        }
      },
      "required": ["uid", "rikzenId", "fullName", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private PII and personal preferences accessible strictly by owner or admin",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID"
        },
        "rikzenId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 24,
          "pattern": "^RIKZEN-[A-Z0-9]{4,12}$",
          "description": "Permanent unique RIKZEN User ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Private verified email"
        },
        "phone": {
          "type": "string",
          "maxLength": 32,
          "description": "Private phone number"
        },
        "dateOfBirth": {
          "type": "string",
          "maxLength": 24,
          "description": "Optional date of birth"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light", "system"],
          "description": "Preferred UI theme"
        },
        "wallpaper": {
          "type": "string",
          "enum": ["obsidian-web", "midnight", "emerald-silk", "champagne-mist"],
          "description": "Chat wallpaper selection"
        },
        "accentColor": {
          "type": "string",
          "enum": ["gold", "emerald", "ivory"],
          "description": "Accent color choice"
        },
        "fontSize": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "description": "Typography scale"
        },
        "bubbleStyle": {
          "type": "string",
          "enum": ["rounded", "classic", "minimal"],
          "description": "Chat bubble style"
        },
        "appLanguage": {
          "type": "string",
          "maxLength": 16,
          "description": "Preferred app language code"
        },
        "readReceipts": {
          "type": "boolean",
          "description": "Read receipt preference"
        },
        "discoverableByName": {
          "type": "boolean",
          "description": "Name discovery preference"
        },
        "discoverableByPhone": {
          "type": "boolean",
          "description": "Phone discovery preference"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Update server timestamp"
        }
      },
      "required": ["uid", "rikzenId", "email", "createdAt", "updatedAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Cross-user friend connection request",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Request document ID"
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sender Firebase Auth UID"
        },
        "receiverUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Receiver Firebase Auth UID"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected"],
          "description": "Current friend request state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Last state change server timestamp"
        }
      },
      "required": ["id", "senderUid", "receiverUid", "status", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct or group chat room header",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Conversation ID"
        },
        "type": {
          "type": "string",
          "enum": ["direct", "group"],
          "description": "Conversation type"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Conversation or group title"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID who created the conversation"
        },
        "peerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Optional second user UID for 1-to-1 chats"
        },
        "lastMessageText": {
          "type": "string",
          "maxLength": 500,
          "description": "Latest message preview"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Last message server timestamp"
        }
      },
      "required": ["id", "type", "title", "createdBy", "createdAt", "updatedAt"]
    },
    "ConversationMember": {
      "title": "ConversationMember",
      "description": "Membership record inside a conversation subcollection",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Member Firebase Auth UID"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent conversation ID"
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin", "member"],
          "description": "Member role inside conversation"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Membership creation timestamp"
        }
      },
      "required": ["uid", "conversationId", "role", "joinedAt"]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "Real-time message stored inside a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Message ID"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent conversation ID"
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Author Firebase Auth UID"
        },
        "recipientUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Optional direct peer UID"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Message body"
        },
        "messageType": {
          "type": "string",
          "enum": ["text", "image", "video", "document", "audio", "voice", "location", "system"],
          "description": "Message kind"
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Soft-delete flag"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Pin flag"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Last update server timestamp"
        }
      },
      "required": ["id", "conversationId", "senderUid", "content", "messageType", "isDeleted", "createdAt", "updatedAt"]
    },
    "StatusUpdate": {
      "title": "StatusUpdate",
      "description": "24-hour expiring status update",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Status ID"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Author Firebase Auth UID"
        },
        "mediaType": {
          "type": "string",
          "enum": ["text", "image", "video"],
          "description": "Status media type"
        },
        "content": {
          "type": "string",
          "maxLength": 1000,
          "description": "Status text content"
        },
        "mediaUrl": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional status media URL"
        },
        "caption": {
          "type": "string",
          "maxLength": 300,
          "description": "Status caption"
        },
        "backgroundColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Status card background color"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "24-hour expiration timestamp"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation server timestamp"
        }
      },
      "required": ["id", "authorUid", "mediaType", "expiresAt", "createdAt"]
    },
    "CallRecord": {
      "title": "CallRecord",
      "description": "1-to-1 voice or video call log",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Call ID"
        },
        "callerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Caller Firebase Auth UID"
        },
        "calleeUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Callee Firebase Auth UID"
        },
        "callType": {
          "type": "string",
          "enum": ["voice", "video"],
          "description": "Call type"
        },
        "status": {
          "type": "string",
          "enum": ["ringing", "connected", "ended", "missed", "rejected"],
          "description": "Call state"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Call start timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Last call update timestamp"
        }
      },
      "required": ["id", "callerUid", "calleeUid", "callType", "status", "startedAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "User-scoped notification item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Notification ID"
        },
        "recipientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target user UID"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Notification title"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Notification message"
        },
        "isRead": {
          "type": "boolean",
          "description": "Read flag"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation server timestamp"
        }
      },
      "required": ["id", "recipientUid", "title", "body", "isRead", "createdAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Safety and moderation report submitted by a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Report ID"
        },
        "reporterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reporter Firebase Auth UID"
        },
        "targetType": {
          "type": "string",
          "enum": ["user", "message", "group", "channel", "feedback"],
          "description": "Target category"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Target identifier"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Report reason or feedback message"
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved", "dismissed"],
          "description": "Moderation state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation server timestamp"
        }
      },
      "required": ["id", "reporterUid", "targetType", "targetId", "reason", "status", "createdAt"]
    }
  },
  "firestore": {
    "/test/connection": {
      "schema": { "$ref": "#/entities/ConnectionTest" },
      "description": "Health and connectivity check document"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator directory"
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Non-PII public discovery profile keyed by Firebase UID"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private PII and account preferences strictly isolated to owner and admins"
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend connection requests between verified users"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Conversation metadata records"
    },
    "/conversations/{conversationId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/ConversationMember" },
      "description": "Conversation membership subcollection (Master Gate)"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConversationMessage" },
      "description": "Conversation messages gated by parent membership subcollection"
    },
    "/statuses/{statusId}": {
      "schema": { "$ref": "#/entities/StatusUpdate" },
      "description": "24-hour status updates"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallRecord" },
      "description": "Voice and video call records"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User-owned notifications"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "User safety reports and feedback"
    }
  }
}
