rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'phonedata9955@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isConversationMember(conversationId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)/members/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'rikzenId', 'fullName', 'onboardingCompleted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'rikzenId', 'fullName', 'avatarUrl', 'bio', 'onboardingCompleted', 'isOnline', 'discoverableByName', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.rikzenId is string && data.rikzenId.size() >= 8 && data.rikzenId.size() <= 24 &&
        data.rikzenId.matches('^RIKZEN-[A-Z0-9]{4,12}$') &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
        (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 220)) &&
        data.onboardingCompleted is bool &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('discoverableByName' in data) || data.discoverableByName is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateUser(data) {
      return data.keys().hasAll(['uid', 'rikzenId', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'rikzenId', 'email', 'phone', 'dateOfBirth',
          'theme', 'wallpaper', 'accentColor', 'fontSize', 'bubbleStyle',
          'appLanguage', 'readReceipts', 'discoverableByName', 'discoverableByPhone',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.rikzenId is string && data.rikzenId.size() >= 8 && data.rikzenId.size() <= 24 &&
        data.rikzenId.matches('^RIKZEN-[A-Z0-9]{4,12}$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 32)) &&
        (!('dateOfBirth' in data) || data.dateOfBirth == null || (data.dateOfBirth is string && data.dateOfBirth.size() <= 24)) &&
        (!('theme' in data) || (data.theme is string && data.theme in ['dark', 'light', 'system'])) &&
        (!('wallpaper' in data) || (data.wallpaper is string && data.wallpaper in ['obsidian-web', 'midnight', 'emerald-silk', 'champagne-mist'])) &&
        (!('accentColor' in data) || (data.accentColor is string && data.accentColor in ['gold', 'emerald', 'ivory'])) &&
        (!('fontSize' in data) || (data.fontSize is string && data.fontSize in ['small', 'medium', 'large'])) &&
        (!('bubbleStyle' in data) || (data.bubbleStyle is string && data.bubbleStyle in ['rounded', 'classic', 'minimal'])) &&
        (!('appLanguage' in data) || (data.appLanguage is string && data.appLanguage.size() <= 16)) &&
        (!('readReceipts' in data) || data.readReceipts is bool) &&
        (!('discoverableByName' in data) || data.discoverableByName is bool) &&
        (!('discoverableByPhone' in data) || data.discoverableByPhone is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll(['id', 'senderUid', 'receiverUid', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'senderUid', 'receiverUid', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.senderUid) &&
        isValidId(data.receiverUid) &&
        data.senderUid != data.receiverUid &&
        data.status is string && data.status in ['pending', 'accepted', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'type', 'title', 'createdBy', 'peerUid', 'lastMessageText', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.type is string && data.type in ['direct', 'group'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        isValidId(data.createdBy) &&
        (!('peerUid' in data) || data.peerUid == null || isValidId(data.peerUid)) &&
        (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversationMember(data) {
      return data.keys().hasAll(['uid', 'conversationId', 'role', 'joinedAt']) &&
        data.keys().hasOnly(['uid', 'conversationId', 'role', 'joinedAt']) &&
        isValidId(data.uid) &&
        isValidId(data.conversationId) &&
        data.role is string && data.role in ['owner', 'admin', 'member'] &&
        data.joinedAt is timestamp;
    }

    function isValidConversationMessage(data) {
      return data.keys().hasAll(['id', 'conversationId', 'senderUid', 'content', 'messageType', 'isDeleted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'conversationId', 'senderUid', 'recipientUid', 'content', 'messageType', 'isDeleted', 'isPinned', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.conversationId) &&
        isValidId(data.senderUid) &&
        (!('recipientUid' in data) || data.recipientUid == null || isValidId(data.recipientUid)) &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
        data.messageType is string && data.messageType in ['text', 'image', 'video', 'document', 'audio', 'voice', 'location', 'system'] &&
        data.isDeleted is bool &&
        (!('isPinned' in data) || data.isPinned is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStatusUpdate(data) {
      return data.keys().hasAll(['id', 'authorUid', 'mediaType', 'expiresAt', 'createdAt']) &&
        data.keys().hasOnly(['id', 'authorUid', 'mediaType', 'content', 'mediaUrl', 'caption', 'backgroundColor', 'expiresAt', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.authorUid) &&
        data.mediaType is string && data.mediaType in ['text', 'image', 'video'] &&
        (!('content' in data) || (data.content is string && data.content.size() <= 1000)) &&
        (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 1024)) &&
        (!('caption' in data) || (data.caption is string && data.caption.size() <= 300)) &&
        (!('backgroundColor' in data) || (data.backgroundColor is string && data.backgroundColor.size() <= 32)) &&
        data.expiresAt is timestamp &&
        data.createdAt is timestamp &&
        data.expiresAt > data.createdAt;
    }

    function isValidCallRecord(data) {
      return data.keys().hasAll(['id', 'callerUid', 'calleeUid', 'callType', 'status', 'startedAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'callerUid', 'calleeUid', 'callType', 'status', 'startedAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.callerUid) &&
        isValidId(data.calleeUid) &&
        data.callerUid != data.calleeUid &&
        data.callType is string && data.callType in ['voice', 'video'] &&
        data.status is string && data.status in ['ringing', 'connected', 'ended', 'missed', 'rejected'] &&
        data.startedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'recipientUid', 'title', 'body', 'isRead', 'createdAt']) &&
        data.keys().hasOnly(['id', 'recipientUid', 'title', 'body', 'isRead', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.recipientUid) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['id', 'reporterUid', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'reporterUid', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.reporterUid) &&
        data.targetType is string && data.targetType in ['user', 'message', 'group', 'channel', 'feedback'] &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 1000 &&
        data.status is string && data.status in ['open', 'resolved', 'dismissed'] &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Group Queries
    // -------------------------------------------------------------------------
    match /{path=**}/members/{memberId} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminRole(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /publicProfiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.onboardingCompleted == true ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isVerified() &&
        isValidId(userId) &&
        isValidPublicProfile(incoming()) &&
        isOwner(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidPublicProfile(incoming()) && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().rikzenId == existing().rikzenId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'avatarUrl', 'bio', 'onboardingCompleted', 'isOnline', 'discoverableByName', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'phonedata9955@gmail.com')
      );
      allow create: if isVerified() &&
        isValidId(userId) &&
        isValidPrivateUser(incoming()) &&
        isOwner(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidPrivateUser(incoming()) && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().rikzenId == existing().rikzenId &&
            incoming().email == existing().email &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'phone', 'dateOfBirth', 'theme', 'wallpaper',
              'accentColor', 'fontSize', 'bubbleStyle', 'appLanguage',
              'readReceipts', 'discoverableByName', 'discoverableByPhone', 'updatedAt'
            ])
          )
        );
      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);
    }

    match /friendRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        existing().senderUid == request.auth.uid ||
        existing().receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow create: if isVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().senderUid == request.auth.uid &&
        incoming().receiverUid != request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/publicProfiles/$(incoming().receiverUid));
      allow update: if isVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming()) && (
          isAdmin() || (
            existing().status == 'pending' &&
            existing().receiverUid == request.auth.uid &&
            incoming().status in ['accepted', 'rejected'] &&
            incoming().id == existing().id &&
            incoming().senderUid == existing().senderUid &&
            incoming().receiverUid == existing().receiverUid &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(requestId) && isSignedIn() && (
        existing().senderUid == request.auth.uid ||
        existing().receiverUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && (isConversationMember(conversationId) || isAdmin());
      allow list: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.peerUid == request.auth.uid
      );
      allow create: if isVerified() &&
        isValidId(conversationId) &&
        isValidConversation(incoming()) &&
        incoming().id == conversationId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/conversations/$(conversationId)/members/$(request.auth.uid));
      allow update: if isVerified() &&
        isValidId(conversationId) &&
        isValidConversation(incoming()) && (
          isAdmin() || (
            isConversationMember(conversationId) &&
            incoming().id == existing().id &&
            incoming().type == existing().type &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastMessageText', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(conversationId);

      match /members/{memberId} {
        allow get: if isValidId(conversationId) && isValidId(memberId) && (
          isOwner(memberId) || isConversationMember(conversationId) || isAdmin()
        );
        allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow create: if isVerified() &&
          isValidId(conversationId) &&
          isValidId(memberId) &&
          isValidConversationMember(incoming()) &&
          incoming().uid == memberId &&
          incoming().conversationId == conversationId &&
          incoming().joinedAt == request.time &&
          (
            isAdmin() ||
            (incoming().uid == request.auth.uid && incoming().role == 'owner' &&
              getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid) ||
            (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid) ||
            (existsAfter(/databases/$(database)/documents/conversations/$(conversationId)) &&
              getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid)
          );
        allow update: if isVerified() &&
          isValidId(conversationId) &&
          isValidId(memberId) &&
          isValidConversationMember(incoming()) && (
            isAdmin() || (
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid &&
              incoming().uid == existing().uid &&
              incoming().conversationId == existing().conversationId &&
              incoming().joinedAt == existing().joinedAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['role'])
            )
          );
        allow delete: if isValidId(conversationId) && isValidId(memberId) && (
          isOwner(memberId) ||
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid ||
          isAdmin()
        );
      }

      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && (
          isConversationMember(conversationId) || isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        );
        allow create: if isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          isValidConversationMessage(incoming()) &&
          incoming().id == messageId &&
          incoming().conversationId == conversationId &&
          incoming().senderUid == request.auth.uid &&
          incoming().isDeleted == false &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isConversationMember(conversationId);
        allow update: if isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          isValidConversationMessage(incoming()) && (
            isAdmin() || (
              isConversationMember(conversationId) &&
              existing().senderUid == request.auth.uid &&
              existing().isDeleted == false &&
              incoming().id == existing().id &&
              incoming().conversationId == existing().conversationId &&
              incoming().senderUid == existing().senderUid &&
              incoming().messageType == existing().messageType &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['content', 'isDeleted', 'isPinned', 'updatedAt'])
            )
          );
        allow delete: if isValidId(conversationId) && isValidId(messageId) && (
          (isConversationMember(conversationId) && existing().senderUid == request.auth.uid) ||
          isAdmin()
        );
      }
    }

    match /statuses/{statusId} {
      allow get: if isValidId(statusId) && isSignedIn();
      allow list: if isSignedIn() &&
        resource.data.mediaType in ['text', 'image', 'video'] &&
        resource.data.expiresAt is timestamp &&
        resource.data.authorUid is string;
      allow create: if isVerified() &&
        isValidId(statusId) &&
        isValidStatusUpdate(incoming()) &&
        incoming().id == statusId &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(statusId) && isSignedIn() && (
        existing().authorUid == request.auth.uid || isAdmin()
      );
    }

    match /calls/{callId} {
      allow get: if isValidId(callId) && isSignedIn() && (
        existing().callerUid == request.auth.uid ||
        existing().calleeUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );
      allow create: if isVerified() &&
        isValidId(callId) &&
        isValidCallRecord(incoming()) &&
        incoming().id == callId &&
        incoming().callerUid == request.auth.uid &&
        incoming().status == 'ringing' &&
        incoming().startedAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(callId) &&
        isValidCallRecord(incoming()) && (
          isAdmin() || (
            (existing().callerUid == request.auth.uid || existing().calleeUid == request.auth.uid) &&
            !(existing().status in ['ended', 'missed', 'rejected']) &&
            incoming().id == existing().id &&
            incoming().callerUid == existing().callerUid &&
            incoming().calleeUid == existing().calleeUid &&
            incoming().callType == existing().callType &&
            incoming().startedAt == existing().startedAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(callId);
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        existing().recipientUid == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isVerified() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().id == notificationId &&
        incoming().createdAt == request.time &&
        (isAdmin() || incoming().recipientUid == request.auth.uid);
      allow update: if isVerified() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) && (
          isAdmin() || (
            existing().recipientUid == request.auth.uid &&
            incoming().id == existing().id &&
            incoming().recipientUid == existing().recipientUid &&
            incoming().title == existing().title &&
            incoming().body == existing().body &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          )
        );
      allow delete: if isValidId(notificationId) && isSignedIn() && (
        existing().recipientUid == request.auth.uid || isAdmin()
      );
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (
        existing().reporterUid == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.reporterUid == request.auth.uid ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'phonedata9955@gmail.com')
      );
      allow create: if isVerified() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().id == reportId &&
        incoming().reporterUid == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time;
      allow update: if isVerified() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        isAdmin();
      allow delete: if isAdmin() && isValidId(reportId);
    }
  }
}
