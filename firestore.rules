rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'phonedata9955@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isConversationMember(conversationId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)/members/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'rikzenId', 'fullName', 'onboardingCompleted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'rikzenId', 'fullName', 'avatarUrl', 'bio', 'onboardingCompleted',
          'isOnline', 'lastSeenPrivacy', 'onlineStatusPrivacy', 'discoverableByName',
          'typingInConversationId', 'typingActivity', 'typingUpdatedAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.rikzenId is string && data.rikzenId.size() >= 8 && data.rikzenId.size() <= 24 &&
        data.rikzenId.matches('^RIKZEN-[A-Z0-9]{4,12}$') &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
        (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 220)) &&
        data.onboardingCompleted is bool &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('lastSeenPrivacy' in data) || (data.lastSeenPrivacy is string && data.lastSeenPrivacy in ['everyone', 'friends', 'nobody'])) &&
        (!('onlineStatusPrivacy' in data) || (data.onlineStatusPrivacy is string && data.onlineStatusPrivacy in ['everyone', 'friends', 'nobody'])) &&
        (!('discoverableByName' in data) || data.discoverableByName is bool) &&
        (!('typingInConversationId' in data) || data.typingInConversationId == null || (data.typingInConversationId is string && data.typingInConversationId.size() <= 128)) &&
        (!('typingActivity' in data) || data.typingActivity == null || (data.typingActivity is string && data.typingActivity in ['typing', 'recording', 'idle'])) &&
        (!('typingUpdatedAt' in data) || data.typingUpdatedAt == null || data.typingUpdatedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateUser(data) {
      return data.keys().hasAll(['uid', 'rikzenId', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'rikzenId', 'email', 'phone', 'dateOfBirth',
          'theme', 'wallpaper', 'accentColor', 'fontSize', 'bubbleStyle',
          'appLanguage', 'lastSeen', 'onlineStatus', 'profilePhoto',
          'bioVisibility', 'emailVisibility', 'friendRequests',
          'readReceipts', 'discoverableByName', 'discoverableByPhone',
          'blockedUids', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.rikzenId is string && data.rikzenId.size() >= 8 && data.rikzenId.size() <= 24 &&
        data.rikzenId.matches('^RIKZEN-[A-Z0-9]{4,12}$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 32)) &&
        (!('dateOfBirth' in data) || data.dateOfBirth == null || (data.dateOfBirth is string && data.dateOfBirth.size() <= 24)) &&
        (!('theme' in data) || (data.theme is string && data.theme in ['dark', 'light', 'system'])) &&
        (!('wallpaper' in data) || (data.wallpaper is string && data.wallpaper in ['obsidian-web', 'midnight', 'emerald-silk', 'champagne-mist'])) &&
        (!('accentColor' in data) || (data.accentColor is string && data.accentColor in ['gold', 'emerald', 'ivory'])) &&
        (!('fontSize' in data) || (data.fontSize is string && data.fontSize in ['small', 'medium', 'large'])) &&
        (!('bubbleStyle' in data) || (data.bubbleStyle is string && data.bubbleStyle in ['rounded', 'classic', 'minimal'])) &&
        (!('appLanguage' in data) || (data.appLanguage is string && data.appLanguage.size() <= 16)) &&
        (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen in ['everyone', 'friends', 'nobody'])) &&
        (!('onlineStatus' in data) || (data.onlineStatus is string && data.onlineStatus in ['everyone', 'friends', 'nobody'])) &&
        (!('profilePhoto' in data) || (data.profilePhoto is string && data.profilePhoto in ['everyone', 'friends', 'nobody'])) &&
        (!('bioVisibility' in data) || (data.bioVisibility is string && data.bioVisibility in ['everyone', 'friends', 'nobody'])) &&
        (!('emailVisibility' in data) || (data.emailVisibility is string && data.emailVisibility in ['everyone', 'friends', 'nobody'])) &&
        (!('friendRequests' in data) || (data.friendRequests is string && data.friendRequests in ['everyone', 'nobody'])) &&
        (!('readReceipts' in data) || data.readReceipts is bool) &&
        (!('discoverableByName' in data) || data.discoverableByName is bool) &&
        (!('discoverableByPhone' in data) || data.discoverableByPhone is bool) &&
        (!('blockedUids' in data) || (data.blockedUids is list && data.blockedUids.size() <= 200)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll(['id', 'senderUid', 'receiverUid', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'senderUid', 'receiverUid', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.senderUid) &&
        isValidId(data.receiverUid) &&
        data.senderUid != data.receiverUid &&
        data.status is string && data.status in ['pending', 'accepted', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'type', 'title', 'description', 'avatarUrl', 'inviteCode',
          'onlyAdminsMessage', 'onlyAdminsEditInfo', 'createdBy', 'peerUid', 'memberUids',
          'lastMessageId', 'lastMessageText', 'lastMessageType', 'lastMessageSenderUid',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.type is string && data.type in ['direct', 'group'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
        (!('inviteCode' in data) || data.inviteCode == null || (data.inviteCode is string && data.inviteCode.size() <= 32)) &&
        (!('onlyAdminsMessage' in data) || data.onlyAdminsMessage is bool) &&
        (!('onlyAdminsEditInfo' in data) || data.onlyAdminsEditInfo is bool) &&
        isValidId(data.createdBy) &&
        (!('peerUid' in data) || data.peerUid == null || isValidId(data.peerUid)) &&
        (!('memberUids' in data) || (data.memberUids is list && data.memberUids.size() <= 100)) &&
        (!('lastMessageId' in data) || data.lastMessageId == null || (data.lastMessageId is string && data.lastMessageId.size() <= 128)) &&
        (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
        (!('lastMessageType' in data) || (data.lastMessageType is string && data.lastMessageType.size() <= 32)) &&
        (!('lastMessageSenderUid' in data) || data.lastMessageSenderUid == null || isValidId(data.lastMessageSenderUid)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversationMember(data) {
      return data.keys().hasAll(['uid', 'conversationId', 'role', 'joinedAt']) &&
        data.keys().hasOnly([
          'uid', 'conversationId', 'role', 'muted', 'archived', 'pinned',
          'markedUnread', 'disappearingSeconds', 'chatTheme', 'customList',
          'clearedAt', 'lastReadAt', 'joinedAt'
        ]) &&
        isValidId(data.uid) &&
        isValidId(data.conversationId) &&
        data.role is string && data.role in ['owner', 'admin', 'member'] &&
        (!('muted' in data) || data.muted is bool) &&
        (!('archived' in data) || data.archived is bool) &&
        (!('pinned' in data) || data.pinned is bool) &&
        (!('markedUnread' in data) || data.markedUnread is bool) &&
        (!('disappearingSeconds' in data) || data.disappearingSeconds is int) &&
        (!('chatTheme' in data) || data.chatTheme == null || (data.chatTheme is string && data.chatTheme.size() <= 32)) &&
        (!('customList' in data) || (data.customList is string && data.customList.size() <= 64)) &&
        (!('clearedAt' in data) || data.clearedAt == null || data.clearedAt is timestamp) &&
        (!('lastReadAt' in data) || data.lastReadAt == null || data.lastReadAt is timestamp) &&
        data.joinedAt is timestamp;
    }

    function isValidConversationMessage(data) {
      return data.keys().hasAll(['id', 'conversationId', 'senderUid', 'content', 'messageType', 'isDeleted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'conversationId', 'senderUid', 'recipientUid', 'memberUids',
          'content', 'messageType', 'replyToId', 'replyToText', 'replyToSender', 'replyToType',
          'forwardedFromId', 'fileUrl', 'fileName', 'mimeType', 'sizeBytes',
          'durationSeconds', 'latitude', 'longitude',
          'isEdited', 'isDeleted', 'isPinned', 'starredBy', 'deletedForUids', 'reactions',
          'deliveredAt', 'readAt', 'expiresAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.conversationId) &&
        isValidId(data.senderUid) &&
        (!('recipientUid' in data) || data.recipientUid == null || isValidId(data.recipientUid)) &&
        (!('memberUids' in data) || (data.memberUids is list && data.memberUids.size() <= 100)) &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
        data.messageType is string && data.messageType in ['text', 'image', 'video', 'document', 'audio', 'voice', 'location', 'system'] &&
        (!('replyToId' in data) || data.replyToId == null || (data.replyToId is string && data.replyToId.size() <= 128)) &&
        (!('replyToText' in data) || data.replyToText == null || (data.replyToText is string && data.replyToText.size() <= 500)) &&
        (!('replyToSender' in data) || data.replyToSender == null || (data.replyToSender is string && data.replyToSender.size() <= 80)) &&
        (!('replyToType' in data) || data.replyToType == null || (data.replyToType is string && data.replyToType.size() <= 32)) &&
        (!('forwardedFromId' in data) || data.forwardedFromId == null || (data.forwardedFromId is string && data.forwardedFromId.size() <= 128)) &&
        (!('fileUrl' in data) || data.fileUrl == null || (data.fileUrl is string && data.fileUrl.size() <= 1024)) &&
        (!('fileName' in data) || data.fileName == null || (data.fileName is string && data.fileName.size() <= 200)) &&
        (!('mimeType' in data) || data.mimeType == null || (data.mimeType is string && data.mimeType.size() <= 120)) &&
        (!('sizeBytes' in data) || data.sizeBytes is int) &&
        (!('durationSeconds' in data) || data.durationSeconds is int) &&
        (!('latitude' in data) || data.latitude is number) &&
        (!('longitude' in data) || data.longitude is number) &&
        (!('isEdited' in data) || data.isEdited is bool) &&
        data.isDeleted is bool &&
        (!('isPinned' in data) || data.isPinned is bool) &&
        (!('starredBy' in data) || (data.starredBy is list && data.starredBy.size() <= 100)) &&
        (!('deletedForUids' in data) || (data.deletedForUids is list && data.deletedForUids.size() <= 100)) &&
        (!('reactions' in data) || (data.reactions is list && data.reactions.size() <= 200)) &&
        (!('deliveredAt' in data) || data.deliveredAt == null || data.deliveredAt is timestamp) &&
        (!('readAt' in data) || data.readAt == null || data.readAt is timestamp) &&
        (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStatusUpdate(data) {
      return data.keys().hasAll(['id', 'authorUid', 'mediaType', 'expiresAt', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'authorUid', 'mediaType', 'content', 'mediaUrl',
          'caption', 'backgroundColor', 'privacy', 'expiresAt', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.authorUid) &&
        data.mediaType is string && data.mediaType in ['text', 'image', 'video'] &&
        (!('content' in data) || (data.content is string && data.content.size() <= 1000)) &&
        (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 1024)) &&
        (!('caption' in data) || (data.caption is string && data.caption.size() <= 300)) &&
        (!('backgroundColor' in data) || (data.backgroundColor is string && data.backgroundColor.size() <= 32)) &&
        (!('privacy' in data) || (data.privacy is string && data.privacy in ['everyone', 'friends', 'contacts', 'selected'])) &&
        data.expiresAt is timestamp &&
        data.createdAt is timestamp &&
        data.expiresAt > data.createdAt;
    }

    function isValidStatusView(data) {
      return data.keys().hasAll(['viewerUid', 'viewedAt']) &&
        data.keys().hasOnly(['viewerUid', 'viewerName', 'viewerAvatar', 'viewerRikzenId', 'reaction', 'viewedAt']) &&
        isValidId(data.viewerUid) &&
        (!('viewerName' in data) || (data.viewerName is string && data.viewerName.size() <= 80)) &&
        (!('viewerAvatar' in data) || data.viewerAvatar == null || (data.viewerAvatar is string && data.viewerAvatar.size() <= 512)) &&
        (!('viewerRikzenId' in data) || (data.viewerRikzenId is string && data.viewerRikzenId.size() <= 24)) &&
        (!('reaction' in data) || data.reaction == null || (data.reaction is string && data.reaction.size() <= 16)) &&
        data.viewedAt is timestamp;
    }

    function isValidCallRecord(data) {
      return data.keys().hasAll(['id', 'callerUid', 'calleeUid', 'callType', 'status', 'startedAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'callerUid', 'calleeUid', 'callType', 'status',
          'offerSdp', 'answerSdp', 'durationSeconds', 'startedAt', 'endedAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.callerUid) &&
        isValidId(data.calleeUid) &&
        data.callerUid != data.calleeUid &&
        data.callType is string && data.callType in ['voice', 'video'] &&
        data.status is string && data.status in ['ringing', 'connected', 'ended', 'missed', 'rejected', 'busy'] &&
        (!('offerSdp' in data) || data.offerSdp == null || (data.offerSdp is string && data.offerSdp.size() <= 30000)) &&
        (!('answerSdp' in data) || data.answerSdp == null || (data.answerSdp is string && data.answerSdp.size() <= 30000)) &&
        (!('durationSeconds' in data) || data.durationSeconds is int) &&
        (!('endedAt' in data) || data.endedAt == null || data.endedAt is timestamp) &&
        data.startedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCallCandidate(data) {
      return data.keys().hasAll(['id', 'senderUid', 'candidate', 'createdAt']) &&
        data.keys().hasOnly(['id', 'senderUid', 'candidate', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.senderUid) &&
        data.candidate is string && data.candidate.size() >= 2 && data.candidate.size() <= 4000 &&
        data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'recipientUid', 'title', 'body', 'isRead', 'createdAt']) &&
        data.keys().hasOnly(['id', 'recipientUid', 'type', 'title', 'body', 'isRead', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.recipientUid) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 40)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['id', 'reporterUid', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'reporterUid', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.reporterUid) &&
        data.targetType is string && data.targetType in ['user', 'message', 'group', 'channel', 'feedback'] &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 1000 &&
        data.status is string && data.status in ['open', 'resolved', 'dismissed'] &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Group Queries
    // -------------------------------------------------------------------------
    match /{path=**}/members/{memberId} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminRole(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /publicProfiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.onboardingCompleted == true ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isVerified() &&
        isValidId(userId) &&
        isValidPublicProfile(incoming()) &&
        isOwner(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidPublicProfile(incoming()) && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().rikzenId == existing().rikzenId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'avatarUrl', 'bio', 'onboardingCompleted', 'isOnline',
              'lastSeenPrivacy', 'onlineStatusPrivacy', 'discoverableByName',
              'typingInConversationId', 'typingActivity', 'typingUpdatedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'phonedata9955@gmail.com')
      );
      allow create: if isVerified() &&
        isValidId(userId) &&
        isValidPrivateUser(incoming()) &&
        isOwner(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidPrivateUser(incoming()) && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().rikzenId == existing().rikzenId &&
            incoming().email == existing().email &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'phone', 'dateOfBirth', 'theme', 'wallpaper',
              'accentColor', 'fontSize', 'bubbleStyle', 'appLanguage',
              'lastSeen', 'onlineStatus', 'profilePhoto', 'bioVisibility',
              'emailVisibility', 'friendRequests', 'readReceipts',
              'discoverableByName', 'discoverableByPhone', 'blockedUids', 'updatedAt'
            ])
          )
        );
      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);
    }

    match /friendRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        existing().senderUid == request.auth.uid ||
        existing().receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow create: if isVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().senderUid == request.auth.uid &&
        incoming().receiverUid != request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/publicProfiles/$(incoming().receiverUid));
      allow update: if isVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming()) && (
          isAdmin() || (
            existing().status == 'pending' &&
            existing().receiverUid == request.auth.uid &&
            incoming().status in ['accepted', 'rejected'] &&
            incoming().id == existing().id &&
            incoming().senderUid == existing().senderUid &&
            incoming().receiverUid == existing().receiverUid &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(requestId) && isSignedIn() && (
        existing().senderUid == request.auth.uid ||
        existing().receiverUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && (isConversationMember(conversationId) || isAdmin());
      allow list: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.peerUid == request.auth.uid ||
        ('memberUids' in resource.data && request.auth.uid in resource.data.memberUids)
      );
      allow create: if isVerified() &&
        isValidId(conversationId) &&
        isValidConversation(incoming()) &&
        incoming().id == conversationId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/conversations/$(conversationId)/members/$(request.auth.uid));
      allow update: if isVerified() &&
        isValidId(conversationId) &&
        isValidConversation(incoming()) && (
          isAdmin() || (
            isConversationMember(conversationId) &&
            incoming().id == existing().id &&
            incoming().type == existing().type &&
            incoming().createdBy == existing().createdBy &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'avatarUrl', 'inviteCode',
              'onlyAdminsMessage', 'onlyAdminsEditInfo', 'memberUids',
              'lastMessageId', 'lastMessageText', 'lastMessageType', 'lastMessageSenderUid',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(conversationId) && (
        isAdmin() ||
        (isVerified() && existing().createdBy == request.auth.uid)
      );

      match /members/{memberId} {
        allow get: if isValidId(conversationId) && isValidId(memberId) && (
          isOwner(memberId) || isConversationMember(conversationId) || isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.conversationId == conversationId
        );
        allow create: if isVerified() &&
          isValidId(conversationId) &&
          isValidId(memberId) &&
          isValidConversationMember(incoming()) &&
          incoming().uid == memberId &&
          incoming().conversationId == conversationId &&
          incoming().joinedAt == request.time &&
          (
            isAdmin() ||
            (incoming().uid == request.auth.uid && incoming().role == 'owner' &&
              getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid) ||
            (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid) ||
            (existsAfter(/databases/$(database)/documents/conversations/$(conversationId)) &&
              getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid)
          );
        allow update: if isVerified() &&
          isValidId(conversationId) &&
          isValidId(memberId) &&
          isValidConversationMember(incoming()) && (
            isAdmin() || (
              isOwner(memberId) &&
              incoming().uid == existing().uid &&
              incoming().conversationId == existing().conversationId &&
              incoming().role == existing().role &&
              incoming().joinedAt == existing().joinedAt &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'muted', 'archived', 'pinned', 'markedUnread',
                'disappearingSeconds', 'chatTheme', 'customList',
                'clearedAt', 'lastReadAt'
              ])
            ) || (
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid &&
              incoming().uid == existing().uid &&
              incoming().conversationId == existing().conversationId &&
              incoming().joinedAt == existing().joinedAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['role'])
            )
          );
        allow delete: if isValidId(conversationId) && isValidId(memberId) && (
          isOwner(memberId) ||
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid ||
          isAdmin()
        );
      }

      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && (
          isConversationMember(conversationId) || isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid ||
          ('memberUids' in resource.data && request.auth.uid in resource.data.memberUids)
        );
        allow create: if isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          isValidConversationMessage(incoming()) &&
          incoming().id == messageId &&
          incoming().conversationId == conversationId &&
          incoming().senderUid == request.auth.uid &&
          incoming().isDeleted == false &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isConversationMember(conversationId);
        allow update: if isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          isValidConversationMessage(incoming()) && (
            isAdmin() || (
              isConversationMember(conversationId) &&
              incoming().id == existing().id &&
              incoming().conversationId == existing().conversationId &&
              incoming().senderUid == existing().senderUid &&
              incoming().messageType == existing().messageType &&
              incoming().createdAt == existing().createdAt &&
              (
                (existing().senderUid == request.auth.uid &&
                 existing().isDeleted == false &&
                 incoming().updatedAt == request.time &&
                 incoming().diff(existing()).affectedKeys().hasOnly(['content', 'isEdited', 'isDeleted', 'isPinned', 'updatedAt'])) ||
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'isPinned', 'reactions', 'starredBy', 'deletedForUids', 'deliveredAt', 'readAt', 'updatedAt'
                ])
              )
            )
          );
        allow delete: if isValidId(conversationId) && isValidId(messageId) && (
          (isConversationMember(conversationId) && existing().senderUid == request.auth.uid) ||
          isAdmin()
        );
      }
    }

    match /statuses/{statusId} {
      allow get: if isValidId(statusId) && isSignedIn();
      allow list: if isSignedIn() &&
        resource.data.mediaType in ['text', 'image', 'video'] &&
        resource.data.expiresAt is timestamp &&
        resource.data.authorUid is string;
      allow create: if isVerified() &&
        isValidId(statusId) &&
        isValidStatusUpdate(incoming()) &&
        incoming().id == statusId &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(statusId) && isSignedIn() && (
        existing().authorUid == request.auth.uid || isAdmin()
      );

      match /views/{viewerUid} {
        allow get, list: if isValidId(statusId) && isSignedIn();
        allow create, update: if isVerified() &&
          isValidId(statusId) &&
          isValidId(viewerUid) &&
          isOwner(viewerUid) &&
          isValidStatusView(incoming()) &&
          incoming().viewerUid == request.auth.uid;
        allow delete: if isValidId(statusId) && isValidId(viewerUid) && (
          isOwner(viewerUid) || isAdmin()
        );
      }
    }

    match /calls/{callId} {
      allow get: if isValidId(callId) && isSignedIn() && (
        existing().callerUid == request.auth.uid ||
        existing().calleeUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );
      allow create: if isVerified() &&
        isValidId(callId) &&
        isValidCallRecord(incoming()) &&
        incoming().id == callId &&
        incoming().callerUid == request.auth.uid &&
        incoming().status == 'ringing' &&
        incoming().startedAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(callId) &&
        isValidCallRecord(incoming()) && (
          isAdmin() || (
            (existing().callerUid == request.auth.uid || existing().calleeUid == request.auth.uid) &&
            !(existing().status in ['ended', 'missed', 'rejected', 'busy']) &&
            incoming().id == existing().id &&
            incoming().callerUid == existing().callerUid &&
            incoming().calleeUid == existing().calleeUid &&
            incoming().callType == existing().callType &&
            incoming().startedAt == existing().startedAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'offerSdp', 'answerSdp', 'durationSeconds', 'endedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(callId);

      match /candidates/{candId} {
        allow get, list: if isValidId(callId) && isSignedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isVerified() &&
          isValidId(callId) &&
          isValidId(candId) &&
          isValidCallCandidate(incoming()) &&
          incoming().id == candId &&
          incoming().senderUid == request.auth.uid &&
          (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
            get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
          );
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        existing().recipientUid == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isVerified() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().id == notificationId &&
        incoming().createdAt == request.time &&
        (isAdmin() || incoming().recipientUid == request.auth.uid);
      allow update: if isVerified() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) && (
          isAdmin() || (
            existing().recipientUid == request.auth.uid &&
            incoming().id == existing().id &&
            incoming().recipientUid == existing().recipientUid &&
            incoming().title == existing().title &&
            incoming().body == existing().body &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          )
        );
      allow delete: if isValidId(notificationId) && isSignedIn() && (
        existing().recipientUid == request.auth.uid || isAdmin()
      );
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (
        existing().reporterUid == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.reporterUid == request.auth.uid ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'phonedata9955@gmail.com')
      );
      allow create: if isVerified() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().id == reportId &&
        incoming().reporterUid == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time;
      allow update: if isVerified() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        isAdmin();
      allow delete: if isAdmin() && isValidId(reportId);
    }
  }
}
